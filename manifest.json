{
  "manifest_version": 3,
  "name": "我的新标签页",
  "version": "1.0.0",
  "description": "紧凑收藏夹列表 + 搜索 + 时钟，直接管理浏览器原生收藏夹",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["bookmarks", "favicon"]
}
